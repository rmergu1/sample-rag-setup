# Copy this file to .env and fill in your values. Never commit the real .env.

# ---- Postgres / pgvector ----
POSTGRES_USER=raguser
POSTGRES_PASSWORD=change_me
POSTGRES_DB=ragdb
POSTGRES_HOST=db
POSTGRES_PORT=5432

# ---- Embedding service ----
EMBEDDING_SERVICE_URL=http://embedding-service:8001
EMBEDDING_MODEL=BAAI/bge-small-en-v1.5

# ---- Retrieval / chunking ----
TOP_K=5
CHUNK_SIZE=800
CHUNK_OVERLAP=100

# ---- Frontend / conversational behaviour ----
COMPANY_NAME=FHIREngine
# Below this cosine similarity, /query skips the LLM and returns NOT_FOUND_MESSAGE directly
SIMILARITY_THRESHOLD=0.35
NOT_FOUND_MESSAGE=Sorry, I don't have that information available at this time. Please directly reach out to the FH team.
# Leave WELCOME_MESSAGE unset to use the built-in default (uses COMPANY_NAME above)
WELCOME_MESSAGE=

# ---- Which provider /query uses when the request doesn't specify one ----
DEFAULT_PROVIDER=groq

# ---- Groq (free tier, OpenAI-compatible, fast inference) ----
# Get a key at https://console.groq.com
GROQ_API_KEY=
GROQ_BASE_URL=https://api.groq.com/openai/v1
GROQ_DEFAULT_MODEL=llama-3.1-8b-instant

# ---- Google Gemini (free tier via AI Studio) ----
# Get a key at https://aistudio.google.com/apikey
GOOGLE_API_KEY=
GOOGLE_BASE_URL=https://generativelanguage.googleapis.com/v1beta
GOOGLE_DEFAULT_MODEL=gemini-1.5-flash

# ---- OpenRouter (free-tier models available, OpenAI-compatible) ----
# Get a key at https://openrouter.ai/keys
OPENROUTER_API_KEY=
OPENROUTER_BASE_URL=https://openrouter.ai/api/v1
OPENROUTER_DEFAULT_MODEL=meta-llama/llama-3.1-8b-instruct:free
